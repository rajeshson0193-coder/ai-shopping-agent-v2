# Optional. The pipeline runs on fixtures without these.
# Live discovery is skipped until the matching key is set.

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
SERPAPI_API_KEY=

# SerpApi monthly quota controls (each HTTP request counts as 1 search).
# Default: 5 calls total per run for laptop OR headphones.
# Split: 1 Google Shopping search + up to 4 product-detail lookups.
# eBay is the primary live source; SerpApi is only a small supplement.
SERPAPI_MAX_CALLS=5

# Optional finer control (still clamped by SERPAPI_MAX_CALLS):
# SERPAPI_MAX_SHOPPING_QUERIES=1
# SERPAPI_MAX_DETAIL_CALLS=4
